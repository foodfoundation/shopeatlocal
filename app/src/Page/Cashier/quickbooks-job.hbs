{{!-- quickbooks-job.hbs
//    ------------------
//    QuickBooks sync job detail --}}

<div class="container-md py-4">
	<h2>QuickBooks sync job {{Job.IDQuickBooksSyncJob}}</h2>

	<p><a href="/quickbooks">&larr; Back to the QuickBooks dashboard</a></p>

	<dl class="row">
		<dt class="col-sm-3">Type</dt>
		<dd class="col-sm-9">{{Job.CdTypeQuickBooksSyncJob}}</dd>
		<dt class="col-sm-3">Source key</dt>
		<dd class="col-sm-9"><code>{{Job.SourceKey}}</code></dd>
		<dt class="col-sm-3">Status</dt>
		<dd class="col-sm-9">
			{{#if (hCkEq Job.CdStatusQuickBooksSyncJob "Posted")}}
			<span class="badge badge-success">Posted</span>
			{{else if (hCkEq Job.CdStatusQuickBooksSyncJob "Blocked")}}
			<span class="badge badge-warning">Blocked</span>
			{{else if (hCkEq Job.CdStatusQuickBooksSyncJob "Failed")}}
			<span class="badge badge-danger">Failed</span>
			{{else}}
			<span class="badge badge-secondary">{{Job.CdStatusQuickBooksSyncJob}}</span>
			{{/if}}
		</dd>
		<dt class="col-sm-3">Attempts</dt>
		<dd class="col-sm-9">{{Job.CtAttempt}}</dd>
		{{#if Job.WhenNextRetry}}
		<dt class="col-sm-3">Next retry</dt>
		<dd class="col-sm-9">{{hTextDateTimeMed Job.WhenNextRetry}}</dd>
		{{/if}}
		{{#if Job.WhenPosted}}
		<dt class="col-sm-3">Posted</dt>
		<dd class="col-sm-9">{{hTextDateTimeMed Job.WhenPosted}}</dd>
		{{/if}}
		{{#if Job.RequestID}}
		<dt class="col-sm-3">Idempotency requestid</dt>
		<dd class="col-sm-9"><code>{{Job.RequestID}}</code></dd>
		{{/if}}
	</dl>

	{{#if Job.Error}}
	<div class="alert alert-danger">
		<strong>Last error:</strong> {{Job.Error}}
	</div>
	{{/if}}

	<p>
		{{#if CkRetryable}}
		<form action="/quickbooks/job/{{Job.IDQuickBooksSyncJob}}/retry" method="POST"
			class="d-inline">
			<input type="hidden" name="_csrf" value="{{TokCSRF}}">
			<button type="submit" class="btn btn-sm btn-primary">Retry job</button>
		</form>
		{{/if}}
		{{#if CkReversible}}
		{{#if (hCkStaffMgrFromUser)}}
		<form action="/quickbooks/job/{{Job.IDQuickBooksSyncJob}}/reverse" method="POST"
			class="d-inline"
			onsubmit="return confirm('Queue a reversing journal for this posted document?')">
			<input type="hidden" name="_csrf" value="{{TokCSRF}}">
			<button type="submit" class="btn btn-sm btn-outline-danger">Queue reversal</button>
		</form>
		{{/if}}
		{{/if}}
	</p>

	{{#if Links}}
	<h5>QuickBooks documents</h5>
	<div class="table-responsive mb-4">
		<table class="table table-sm table-striped">
			<thead><tr><th>Type</th><th>Doc number</th><th>Total</th><th>QuickBooks</th></tr></thead>
			<tbody>
				{{#each Links}}
				<tr>
					<td>{{CdTypeQuickBooksDoc}}</td>
					<td><code>{{DocNumber}}</code></td>
					<td>{{AmtTotal}}</td>
					<td><a href="{{URL}}" target="_blank" rel="noopener">Open in QuickBooks</a></td>
				</tr>
				{{/each}}
			</tbody>
		</table>
	</div>
	{{/if}}

	{{#if PreviewText}}
	<h5>Dry-run preview</h5>
	<p class="text-muted font-size-90">
		What this job would post right now, calculated from current source data.
		Nothing has been sent to QuickBooks.
	</p>
	<pre class="border rounded p-3 bg-light" style="max-height: 24rem; overflow: auto;">{{PreviewText}}</pre>
	{{/if}}

	{{#if PayloadText}}
	<h5>Stored payload</h5>
	<pre class="border rounded p-3 bg-light" style="max-height: 24rem; overflow: auto;">{{PayloadText}}</pre>
	{{/if}}
</div>
